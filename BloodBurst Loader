        local originalPos = container.Position
        tween(container, {Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset - 5, originalPos.Y.Scale, originalPos.Y.Offset)}, 0.05)
        task.wait(0.05)
        tween(container, {Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + 10, originalPos.Y.Scale, originalPos.Y.Offset)}, 0.05)
        task.wait(0.05)
        tween(container, {Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset - 10, originalPos.Y.Scale, originalPos.Y.Offset)}, 0.05)
        task.wait(0.05)
        tween(container, {Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + 5, originalPos.Y.Scale, originalPos.Y.Offset)}, 0.05)
        task.wait(0.05)
        tween(container, {Position = originalPos}, 0.05)
    end
    
    local function showError(msg)
        errorLabel.Text = msg
        errorLabel.Visible = true
        animateShake()
        task.wait(1.5)
        errorLabel.Visible = false
    end
    
    local function saveKeyToFile(key)
        if not isfolder or not writefile then return end
        pcall(function()
            if not isfolder(folderPath) then makefolder(folderPath) end
            writefile(folderPath .. "/" .. fileName .. ".key", key)
        end)
    end
    
    submitBtn.MouseButton1Click:Connect(function()
        local enteredKey = keyInput.Text
        if enteredKey == "" then
            showError("Please enter a key")
            return
        end
        
        local isValid = false
        for _, validKey in pairs(validKeys) do
            if enteredKey == validKey then
                isValid = true
                break
            end
        end
        
        if isValid then
            if saveKey then
                saveKeyToFile(enteredKey)
            end
            tween(container, {BackgroundTransparency = 1}, 0.2)
            task.wait(0.2)
            screenGui:Destroy()
            keySystemActive = false
            onSuccess(enteredKey)
            RayfieldLuna:Notify({
                Title = "Key Verified!",
                Content = "Access granted. Welcome!",
                Type = "success",
                Duration = 3
            })
        else
            attemptsLeft = attemptsLeft - 1
            attemptsLabel.Text = "Attempts remaining: " .. attemptsLeft
            keyInput.Text = ""
            
            if attemptsLeft <= 0 then
                showError("No attempts remaining! Access denied.")
                task.wait(1.5)
                onFail("No attempts remaining")
                screenGui:Destroy()
                keySystemActive = false
            else
                showError("Invalid key! " .. attemptsLeft .. " attempts remaining")
            end
        end
    end)
    
    -- Animate in
    container.BackgroundTransparency = 1
    tween(container, {BackgroundTransparency = 0}, 0.3)
    
    return true
end

