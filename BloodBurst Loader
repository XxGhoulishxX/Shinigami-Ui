            window.CurrentTab = tabPage
        end
        
        local tab = {Page = tabPage, Layout = pageLayout}
        
        function tab:CreateSection(title)
            local section = Instance.new("TextLabel")
            section.Size = UDim2.new(1, 0, 0, 25)
            section.BackgroundTransparency = 1
            section.Text = title
            section.TextColor3 = currentTheme.Primary
            section.TextSize = 10
            section.Font = Enum.Font.GothamBold
            section.TextXAlignment = Enum.TextXAlignment.Left
            section.Parent = self.Page
            return section
        end
        
        function tab:CreateButton(config)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 38)
            btn.BackgroundColor3 = currentTheme.Surf
            btn.Text = config.Text or "Button"
            btn.TextColor3 = currentTheme.Text
            btn.TextSize = 13
            btn.Font = Enum.Font.GothamSemibold
            btn.BorderSizePixel = 0
            btn.AutoButtonColor = false
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 7)
            btnCorner.Parent = btn
            
            local accentBar = Instance.new("Frame")
            accentBar.Size = UDim2.new(0, 3, 1, -6)
            accentBar.Position = UDim2.new(0, 0, 0, 3)
            accentBar.BackgroundColor3 = currentTheme.Primary
            accentBar.BorderSizePixel = 0
            accentBar.Parent = btn
            
            btn.MouseEnter:Connect(function()
                tween(btn, {BackgroundColor3 = currentTheme.SurfHover}, 0.1)
            end)
            btn.MouseLeave:Connect(function()
                tween(btn, {BackgroundColor3 = currentTheme.Surf}, 0.1)
            end)
            btn.MouseButton1Click:Connect(function()
                tween(btn, {BackgroundColor3 = currentTheme.Primary}, 0.05)
                task.wait(0.05)
                tween(btn, {BackgroundColor3 = currentTheme.Surf}, 0.05)
                if config.Callback then pcall(config.Callback) end
            end)
            btn.Parent = self.Page
            return btn
        end
        
        function tab:CreateToggle(config)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, 42)
            frame.BackgroundColor3 = currentTheme.Surf
            frame.BorderSizePixel = 0
            local frameCorner = Instance.new("UICorner")
            frameCorner.CornerRadius = UDim.new(0, 7)
            frameCorner.Parent = frame
            frame.Parent = self.Page
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -65, 1, 0)
            label.Position = UDim2.new(0, 12, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = config.Text or "Toggle"
            label.TextColor3 = currentTheme.Text
            label.TextSize = 12
            label.Font = Enum.Font.Gotham
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = frame
            
            local toggleBtn = Instance.new("TextButton")
            toggleBtn.Size = UDim2.new(0, 44, 0, 22)
            toggleBtn.Position = UDim2.new(1, -54, 0, 10)
            toggleBtn.BackgroundColor3 = currentTheme.BG
            toggleBtn.Text = ""
            toggleBtn.BorderSizePixel = 0
            toggleBtn.AutoButtonColor = false
            local toggleCorner = Instance.new("UICorner")
            toggleCorner.CornerRadius = UDim.new(1, 0)
            toggleCorner.Parent = toggleBtn
            
            local circle = Instance.new("Frame")
            circle.Size = UDim2.new(0, 18, 0, 18)
            circle.Position = UDim2.new(0, 2, 0, 2)
            circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            circle.BorderSizePixel = 0
            local circleCorner = Instance.new("UICorner")
            circleCorner.CornerRadius = UDim.new(1, 0)
            circleCorner.Parent = circle
            circle.Parent = toggleBtn
            
            local state = config.Default or false
            
            local function update()
                if state then
                    toggleBtn.BackgroundColor3 = currentTheme.Primary
                    circle.Position = UDim2.new(0, 24, 0, 2)
                else
                    toggleBtn.BackgroundColor3 = currentTheme.BG
                    circle.Position = UDim2.new(0, 2, 0, 2)
                end
            end
            
            toggleBtn.MouseButton1Click:Connect(function()
                state = not state
                update()
                if config.Callback then pcall(config.Callback, state) end
            end)
            update()
            toggleBtn.Parent = frame
            
            return {Set = function(v) state = v; update() end, Get = function() return state end}
        end
        
        function tab:CreateSlider(config)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, 68)
            frame.BackgroundColor3 = currentTheme.Surf
            frame.BorderSizePixel = 0
            local frameCorner = Instance.new("UICorner")
            frameCorner.CornerRadius = UDim.new(0, 7)
            frameCorner.Parent = frame
            frame.Parent = self.Page
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -20, 0, 22)
            label.Position = UDim2.new(0, 12, 0, 5)
            label.BackgroundTransparency = 1
            label.Text = config.Text or "Slider"
            label.TextColor3 = currentTheme.Text
            label.TextSize = 12
            label.Font = Enum.Font.Gotham
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = frame
            
            local min = config.Min or 0
            local max = config.Max or 100
            local value = math.clamp(config.Default or min, min, max)
            
            local valueLabel = Instance.new("TextLabel")
            valueLabel.Size = UDim2.new(0, 50, 0, 22)
            valueLabel.Position = UDim2.new(1, -60, 0, 5)
            valueLabel.BackgroundTransparency = 1
            valueLabel.Text = config.Suffix and tostring(math.floor(value)) .. config.Suffix or tostring(math.floor(value))
            valueLabel.TextColor3 = currentTheme.Primary
            valueLabel.TextSize = 12
            valueLabel.Font = Enum.Font.GothamBold
            valueLabel.Parent = frame
            
            local sliderBg = Instance.new("Frame")
            sliderBg.Size = UDim2.new(1, -24, 0, 4)
            sliderBg.Position = UDim2.new(0, 12, 0, 48)
            sliderBg.BackgroundColor3 = currentTheme.BG
            sliderBg.BorderSizePixel = 0
            local bgCorner = Instance.new("UICorner")
            bgCorner.CornerRadius = UDim.new(1, 0)
            bgCorner.Parent = sliderBg
            sliderBg.Parent = frame
            
            local sliderFill = Instance.new("Frame")
            sliderFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            sliderFill.BackgroundColor3 = currentTheme.Primary
            sliderFill.BorderSizePixel = 0
            local fillCorner = Instance.new("UICorner")
            fillCorner.CornerRadius = UDim.new(1, 0)
            fillCorner.Parent = sliderFill
            sliderFill.Parent = sliderBg
            
            local knob = Instance.new("TextButton")
            knob.Size = UDim2.new(0, 14, 0, 14)
            knob.Position = UDim2.new((value - min) / (max - min), -7, 0, -5)
            knob.BackgroundColor3 = currentTheme.Primary
            knob.Text = ""
            knob.BorderSizePixel = 0
            knob.AutoButtonColor = false
            local knobCorner = Instance.new("UICorner")
            knobCorner.CornerRadius = UDim.new(1, 0)
            knobCorner.Parent = knob
            knob.Parent = sliderBg
            
            local dragging = false
            
            local function setValue(newValue)
                value = math.clamp(newValue, min, max)
                if config.Increment then
                    value = math.floor(value / config.Increment + 0.5) * config.Increment
                end
                local pos = (value - min) / (max - min)
                sliderFill.Size = UDim2.new(pos, 0, 1, 0)
                knob.Position = UDim2.new(pos, -7, 0, -5)
                valueLabel.Text = config.Suffix and tostring(math.floor(value)) .. config.Suffix or tostring(math.floor(value))
                if config.Callback then pcall(config.Callback, value) end
            end
            
            knob.MouseButton1Down:Connect(function() dragging = true end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
                    setValue(min + (max - min) * pos)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            
            setValue(value)
            return {Set = setValue, Get = function() return value end}
        end
        
        function tab:CreateDropdown(config)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, 42)
            frame.BackgroundColor3 = currentTheme.Surf
            frame.BorderSizePixel = 0
            local frameCorner = Instance.new("UICorner")
            frameCorner.CornerRadius = UDim.new(0, 7)
            frameCorner.Parent = frame
            frame.Parent = self.Page
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -20, 1, 0)
            label.Position = UDim2.new(0, 12, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = config.Text or "Dropdown"
            label.TextColor3 = currentTheme.Text
            label.TextSize = 12
            label.Font = Enum.Font.Gotham
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = frame
            
            local dropdownBtn = Instance.new("TextButton")
            dropdownBtn.Size = UDim2.new(0, 100, 0, 28)
            dropdownBtn.Position = UDim2.new(1, -110, 0, 7)
            dropdownBtn.BackgroundColor3 = currentTheme.BG
            dropdownBtn.Text = config.Default or (config.Options and config.Options[1] or "Select")
            dropdownBtn.TextColor3 = currentTheme.Text
            dropdownBtn.TextSize = 11
            dropdownBtn.Font = Enum.Font.Gotham
            dropdownBtn.BorderSizePixel = 0
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 6)
            btnCorner.Parent = dropdownBtn
            
            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.new(0, 18, 1, 0)
            arrow.Position = UDim2.new(1, -20, 0, 0)
            arrow.BackgroundTransparency = 1
            arrow.Text = "▼"
            arrow.TextColor3 = currentTheme.TextSec
            arrow.TextSize = 9
            arrow.Font = Enum.Font.Gotham
            arrow.Parent = dropdownBtn
            
            local dropdownList = Instance.new("Frame")
            dropdownList.Size = UDim2.new(0, 100, 0, 0)
            dropdownList.Position = UDim2.new(1, -110, 0, 35)
            dropdownList.BackgroundColor3 = currentTheme.Surf
            dropdownList.BorderSizePixel = 0
            dropdownList.Visible = false
            dropdownList.ClipsDescendants = true
            local listCorner = Instance.new("UICorner")
            listCorner.CornerRadius = UDim.new(0, 6)
            listCorner.Parent = dropdownList
            dropdownList.Parent = frame
            
            local listLayout = Instance.new("UIListLayout")
            listLayout.Padding = UDim.new(0, 2)
            listLayout.Parent = dropdownList
            
            local options = config.Options or {}
            local currentOption = config.Default or options[1]
            local open = false
            
            for _, opt in pairs(options) do
                local item = Instance.new("TextButton")
                item.Size = UDim2.new(1, 0, 0, 30)
                item.BackgroundColor3 = currentTheme.Surf
                item.Text = opt
                item.TextColor3 = currentTheme.Text
                item.TextSize = 10
                item.Font = Enum.Font.Gotham
                item.BorderSizePixel = 0
                item.AutoButtonColor = false
                local itemCorner = Instance.new("UICorner")
                itemCorner.CornerRadius = UDim.new(0, 4)
                itemCorner.Parent = item
                item.Parent = dropdownList
                item.MouseButton1Click:Connect(function()
                    dropdownBtn.Text = opt
                    currentOption = opt
                    dropdownList.Visible = false
                    open = false
                    tween(arrow, {Rotation = 0}, 0.2)
                    if config.Callback then pcall(config.Callback, opt) end
                end)
            end
            dropdownList.Size = UDim2.new(0, 100, 0, #options * 32)
            
            dropdownBtn.MouseButton1Click:Connect(function()
                open = not open
                dropdownList.Visible = open
                tween(arrow, {Rotation = open and 180 or 0}, 0.2)
            end)
            
            return {
                Set = function(opt) dropdownBtn.Text = opt; currentOption = opt end,
                Get = function() return currentOption end
            }
        end
        
        function tab:CreateInput(config)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, 42)
            frame.BackgroundColor3 = currentTheme.Surf
            frame.BorderSizePixel = 0
            local frameCorner = Instance.new("UICorner")
            frameCorner.CornerRadius = UDim.new(0, 7)
            frameCorner.Parent = frame
            frame.Parent = self.Page
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -20, 1, 0)
            label.Position = UDim2.new(0, 12, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = config.Text or "Input"
            label.TextColor3 = currentTheme.Text
            label.TextSize = 12
            label.Font = Enum.Font.Gotham
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = frame
            
            local inputBox = Instance.new("TextBox")
            inputBox.Size = UDim2.new(0, 110, 0, 28)
            inputBox.Position = UDim2.new(1, -120, 0, 7)
            inputBox.BackgroundColor3 = currentTheme.BG
            inputBox.Text = config.Default or ""
            inputBox.PlaceholderText = config.Placeholder or "Type..."
            inputBox.TextColor3 = currentTheme.Text
            inputBox.PlaceholderColor3 = currentTheme.TextSec
            inputBox.TextSize = 11
            inputBox.Font = Enum.Font.Gotham
            inputBox.BorderSizePixel = 0
            local inputCorner = Instance.new("UICorner")
            inputCorner.CornerRadius = UDim.new(0, 6)
            inputCorner.Parent = inputBox
            inputBox.Parent = frame
            
            inputBox.FocusLost:Connect(function()
                if config.Callback then pcall(config.Callback, inputBox.Text) end
            end)
            
            return {Set = function(t) inputBox.Text = t end, Get = function() return inputBox.Text end}
        end
        
        function tab:CreateLabel(text, color)
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 0, 25)
            label.BackgroundTransparency = 1
            label.Text = text
            label.TextColor3 = color or currentTheme.TextSec
            label.TextSize = 10
            label.Font = Enum.Font.Gotham
            label.Parent = self.Page
            return label
        end
        
        return tab
    end
    
    return window
end

-- ============ THEME ============
function RayfieldLuna:SetTheme(themeName)
    if Themes[themeName] then
        currentTheme = Themes[themeName]
        RayfieldLuna:Notify({Title = "Theme", Content = "Changed to " .. themeName, Type = "success", Duration = 2})
        return true
    end
    return false
end

return RayfieldLuna
