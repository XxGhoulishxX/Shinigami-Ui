            dropdownBtn.TextSize = LunaUI.Config.MobileOptimized and 14 or 13
            dropdownBtn.Font = Enum.Font.Gotham
            dropdownBtn.BorderSizePixel = 0
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 6)
            btnCorner.Parent = dropdownBtn
            
            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.new(0, 20, 1, 0)
            arrow.Position = UDim2.new(1, -25, 0, 0)
            arrow.BackgroundTransparency = 1
            arrow.Text = "▼"
            arrow.TextColor3 = currentTheme.TextSecondary
            arrow.TextSize = 12
            arrow.Font = Enum.Font.Gotham
            arrow.Parent = dropdownBtn
            
            local dropdownList = Instance.new("Frame")
            dropdownList.Size = UDim2.new(0, LunaUI.Config.MobileOptimized and 160 or 140, 0, 0)
            dropdownList.Position = UDim2.new(1, -(LunaUI.Config.MobileOptimized and 175 or 155), 0, LunaUI.Config.MobileOptimized and 43 or 38)
            dropdownList.BackgroundColor3 = currentTheme.Surface
            dropdownList.BorderSizePixel = 0
            dropdownList.Visible = false
            dropdownList.ClipsDescendants = true
            
            local listCorner = Instance.new("UICorner")
            listCorner.CornerRadius = UDim.new(0, 6)
            listCorner.Parent = dropdownList
            
            local listLayout = Instance.new("UIListLayout")
            listLayout.Padding = UDim.new(0, 2)
            listLayout.Parent = dropdownList
            
            local options = config.Options or {}
            local currentOption = config.Default or options[1]
            
            for _, option in pairs(options) do
                local item = Instance.new("TextButton")
                item.Size = UDim2.new(1, 0, 0, LunaUI.Config.MobileOptimized and 40 or 35)
                item.BackgroundColor3 = currentTheme.Surface
                item.Text = option
                item.TextColor3 = currentTheme.Text
                item.TextSize = LunaUI.Config.MobileOptimized and 14 or 13
                item.Font = Enum.Font.Gotham
                item.BorderSizePixel = 0
                item.AutoButtonColor = false
                
                local itemCorner = Instance.new("UICorner")
                itemCorner.CornerRadius = UDim.new(0, 4)
                itemCorner.Parent = item
                
                item.MouseEnter:Connect(function()
                    tween(item, {BackgroundColor3 = currentTheme.SurfaceHover}, 0.1)
                end)
                
                item.MouseLeave:Connect(function()
                    tween(item, {BackgroundColor3 = currentTheme.Surface}, 0.1)
                end)
                
                item.MouseButton1Click:Connect(function()
                    dropdownBtn.Text = option
                    currentOption = option
                    dropdownList.Visible = false
                    tween(arrow, {Rotation = 0}, 0.2)
                    if config.Callback then pcall(config.Callback, option) end
                end)
                
                item.Parent = dropdownList
            end
            
            dropdownList.Size = UDim2.new(0, LunaUI.Config.MobileOptimized and 160 or 140, 0, #options * (LunaUI.Config.MobileOptimized and 42 or 37))
            dropdownList.Parent = frame
            
            local listOpen = false
            
            dropdownBtn.MouseButton1Click:Connect(function()
                listOpen = not listOpen
                dropdownList.Visible = listOpen
                tween(arrow, {Rotation = listOpen and 180 or 0}, 0.2)
            end)
            
            frame.Parent = self.Page
            
            return {
                SetValue = function(opt) 
                    dropdownBtn.Text = opt
                    currentOption = opt
                end,
                GetValue = function() return currentOption end,
                Refresh = function(newOptions)
                    for _, child in pairs(dropdownList:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    options = newOptions
                    for _, option in pairs(options) do
                        local item = Instance.new("TextButton")
                        item.Size = UDim2.new(1, 0, 0, 35)
                        item.BackgroundColor3 = currentTheme.Surface
                        item.Text = option
                        item.TextColor3 = currentTheme.Text
                        item.TextSize = 13
                        item.Font = Enum.Font.Gotham
                        item.BorderSizePixel = 0
                        item.AutoButtonColor = false
                        
                        local itemCorner = Instance.new("UICorner")
                        itemCorner.CornerRadius = UDim.new(0, 4)
                        itemCorner.Parent = item
                        
                        item.MouseButton1Click:Connect(function()
                            dropdownBtn.Text = option
                            currentOption = option
                            dropdownList.Visible = false
                            if config.Callback then pcall(config.Callback, option) end
                        end)
                        
                        item.Parent = dropdownList
                    end
                    dropdownList.Size = UDim2.new(0, 140, 0, #options * 37)
                end
            }
        end
        
        -- Input
        function tab:CreateInput(config)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, LunaUI.Config.MobileOptimized and 50 or 45)
            frame.BackgroundColor3 = currentTheme.Surface
            frame.BorderSizePixel = 0
            
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 8)
            corner.Parent = frame
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -20, 1, 0)
            label.Position = UDim2.new(0, 15, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = config.Text or "Input"
            label.TextColor3 = currentTheme.Text
            label.TextSize = LunaUI.Config.MobileOptimized and 15 or 14
            label.Font = Enum.Font.Gotham
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = frame
            
            local inputBox = Instance.new("TextBox")
            inputBox.Size = UDim2.new(0, LunaUI.Config.MobileOptimized and 180 or 160, 0, LunaUI.Config.MobileOptimized and 35 or 30)
            inputBox.Position = UDim2.new(1, -(LunaUI.Config.MobileOptimized and 195 or 175), 0, (LunaUI.Config.MobileOptimized and 8 or 8))
            inputBox.BackgroundColor3 = currentTheme.Background
            inputBox.Text = config.Default or ""
            inputBox.PlaceholderText = config.Placeholder or "Type here..."
            inputBox.TextColor3 = currentTheme.Text
            inputBox.PlaceholderColor3 = currentTheme.TextSecondary
            inputBox.TextSize = LunaUI.Config.MobileOptimized and 14 or 13
            inputBox.Font = Enum.Font.Gotham
            inputBox.BorderSizePixel = 0
            
            local inputCorner = Instance.new("UICorner")
            inputCorner.CornerRadius = UDim.new(0, 6)
            inputCorner.Parent = inputBox
            
            inputBox.FocusLost:Connect(function()
                if config.Callback then pcall(config.Callback, inputBox.Text) end
            end)
            
            inputBox.Parent = frame
            frame.Parent = self.Page
            
            return {
                SetValue = function(t) inputBox.Text = t end,
                GetValue = function() return inputBox.Text end
            }
        end
        
        -- Label
        function tab:CreateLabel(text, color)
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 0, LunaUI.Config.MobileOptimized and 35 or 30)
            label.BackgroundTransparency = 1
            label.Text = text
            label.TextColor3 = color or currentTheme.TextSecondary
            label.TextSize = LunaUI.Config.MobileOptimized and 14 or 12
            label.Font = Enum.Font.Gotham
            label.Parent = self.Page
            return {SetText = function(t) label.Text = t end}
        end
        
        -- Paragraph
        function tab:CreateParagraph(config)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, 0)
            frame.BackgroundColor3 = currentTheme.Surface
            frame.BorderSizePixel = 0
            frame.AutomaticSize = Enum.AutomaticSize.Y
            
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 8)
            corner.Parent = frame
            
            local padding = Instance.new("UIPadding")
            padding.PaddingLeft = UDim.new(0, 15)
            padding.PaddingRight = UDim.new(0, 15)
            padding.PaddingTop = UDim.new(0, 12)
            padding.PaddingBottom = UDim.new(0, 12)
            padding.Parent = frame
            
            local title = Instance.new("TextLabel")
            title.Size = UDim2.new(1, 0, 0, 25)
            title.BackgroundTransparency = 1
            title.Text = config.Title or "Title"
            title.TextColor3 = currentTheme.Text
            title.TextSize = LunaUI.Config.MobileOptimized and 16 or 14
            title.Font = Enum.Font.GothamBold
            title.TextXAlignment = Enum.TextXAlignment.Left
            title.Parent = frame
            
            local content = Instance.new("TextLabel")
            content.Size = UDim2.new(1, 0, 0, 0)
            content.BackgroundTransparency = 1
            content.Text = config.Content or "Content goes here..."
            content.TextColor3 = currentTheme.TextSecondary
            content.TextSize = LunaUI.Config.MobileOptimized and 14 or 12
            content.Font = Enum.Font.Gotham
            content.TextXAlignment = Enum.TextXAlignment.Left
            content.TextWrapped = true
            content.AutomaticSize = Enum.AutomaticSize.Y
            content.Parent = frame
            
            frame.Parent = self.Page
            
            return {
                SetTitle = function(t) title.Text = t end,
                SetContent = function(c) content.Text = c end
            }
        end
        
        return tab
    end
    
    return window
end

-- ============ NOTIFICATION ============
function LunaUI:Notify(config)
    local notification = Instance.new("Frame")
    notification.Size = UDim2.new(0, 350, 0, 70)
    notification.Position = UDim2.new(1, 10, 0, 10)
    notification.BackgroundColor3 = currentTheme.Surface
    notification.BorderSizePixel = 0
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = notification
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 25)
    title.Position = UDim2.new(0, 15, 0, 10)
    title.BackgroundTransparency = 1
    title.Text = config.Title or "Notification"
    title.TextColor3 = currentTheme.Text
    title.TextSize = 15
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = notification
    
    local message = Instance.new("TextLabel")
    message.Size = UDim2.new(1, -20, 0, 30)
    message.Position = UDim2.new(0, 15, 0, 35)
    message.BackgroundTransparency = 1
    message.Text = config.Content or "Notification content"
    message.TextColor3 = currentTheme.TextSecondary
    message.TextSize = 12
    message.Font = Enum.Font.Gotham
    message.TextXAlignment = Enum.TextXAlignment.Left
    message.Parent = notification
    
    notification.Parent = CoreGui
    tween(notification, {Position = UDim2.new(1, -360, 0, 10)}, 0.3)
    
    task.wait(config.Duration or 3)
    tween(notification, {Position = UDim2.new(1, 10, 0, 10)}, 0.3)
    task.wait(0.3)
    notification:Destroy()
end

-- ============ DESTROY ============
function LunaUI:Destroy()
    for _, gui in pairs(CoreGui:GetChildren()) do
        if gui.Name:find("LunaUI_") then
            gui:Destroy()
        end
    end
end

return LunaUI
