                listening = true
                keyBtn.Text = "..."
                keyBtn.BackgroundColor3 = currentTheme.Primary
                
                local connection
                connection = UserInputService.InputBegan:Connect(function(input, processed)
                    if not listening then return end
                    if processed then return end
                    
                    local key = input.KeyCode
                    if key ~= Enum.KeyCode.Unknown then
                        local keyName = tostring(key):gsub("Enum.KeyCode.", "")
                        currentKey = keyName
                        keyBtn.Text = keyName
                        keyBtn.BackgroundColor3 = currentTheme.BG
                        listening = false
                        if config.Callback then pcall(config.Callback, keyName) end
                        connection:Disconnect()
                    end
                end)
                
                task.wait(3)
                if listening then
                    keyBtn.Text = currentKey
                    keyBtn.BackgroundColor3 = currentTheme.BG
                    listening = false
                    connection:Disconnect()
                end
            end)
            
            return {
                Set = function(key) currentKey = key; keyBtn.Text = key end,
