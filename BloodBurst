    local notifCorner = Instance.new("UICorner")
    notifCorner.CornerRadius = UDim.new(0, 7)
    notifCorner.Parent = notif
    notif.Parent = CoreGui
    
    local accent = Instance.new("Frame")
    accent.Size = UDim2.new(0, 4, 1, 0)
    accent.BackgroundColor3 = config.Type == "error" and currentTheme.Error or (config.Type == "success" and currentTheme.Success or currentTheme.Primary)
    accent.BorderSizePixel = 0
    local accentCorner = Instance.new("UICorner")
    accentCorner.Parent = accent
    accent.Parent = notif
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 20)
    title.Position = UDim2.new(0, 16, 0, 6)
    title.BackgroundTransparency = 1
    title.Text = config.Title or "Notification"
    title.TextColor3 = currentTheme.Text
    title.TextSize = 13
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = notif
    
    local content = Instance.new("TextLabel")
    content.Size = UDim2.new(1, -20, 0, 20)
    content.Position = UDim2.new(0, 16, 0, 26)
    content.BackgroundTransparency = 1
    content.Text = config.Content or "Notification content"
    content.TextColor3 = currentTheme.TextSec
    content.TextSize = 10
    content.Font = Enum.Font.Gotham
    content.TextXAlignment = Enum.TextXAlignment.Left
    content.Parent = notif
    
    tween(notif, {Position = UDim2.new(1, -270, 0, 10)}, 0.3)
    task.wait(config.Duration or 3)
    tween(notif, {Position = UDim2.new(1, 10, 0, 10)}, 0.3)
    task.wait(0.3)
    notif:Destroy()
end

-- ============ THEME ============
function LunaRayfield:SetTheme(themeName)
    if Themes[themeName] then
        currentTheme = Themes[themeName]
        LunaRayfield:Notify({Title = "Theme", Content = "Changed to " .. themeName, Type = "success", Duration = 2})
        return true
    end
    return false
end

function LunaRayfield:GetTheme()
    for name, theme in pairs(Themes) do
        if theme == currentTheme then return name end
    end
    return "Luna"
end

-- ============ DESTROY ============
function LunaRayfield:Destroy()
    for _, gui in pairs(CoreGui:GetChildren()) do
        if gui.Name:find("LunaRayfield_") then
            gui:Destroy()
        end
    end
end

return LunaRayfield
