-- ============ NOTIFICATION ============
function LunaRayfield:Notify(config)
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 260, 0, 50)
    notif.Position = UDim2.new(1, 10, 0, 10)
    notif.BackgroundColor3 = currentTheme.Surf
